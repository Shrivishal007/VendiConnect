# Application
NODE_ENV=development
PORT=5000

# Database
# Replace with your MongoDB Atlas URI if you use Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/vendiconnect

# CORS: comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Admin authentication
# Set both secrets to unique, randomly generated values before use.
JWT_SECRET=
JWT_EXPIRES_IN=8h
PHONE_HASH_SECRET=

# Firebase Admin SDK service-account JSON; required for resident auth and push notifications.
# Paste the complete service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: only needed by Firebase auth integration tests.
FIREBASE_WEB_API_KEY=

# Admin account used by the seed script
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# Location and alert behavior
LOCATION_TTL_MINUTES=30
WALKING_SPEED_KMH=3.5
STALE_SIGNAL_THRESHOLD_MINUTES=30
ALERT_THROTTLE_MINUTES=45
RATING_PROXIMITY_WINDOW_HOURS=2

# Request limits
RATE_LIMIT_PUBLIC=300
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOCATION=30
