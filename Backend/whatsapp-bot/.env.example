# Application
NODE_ENV=development
PORT=5001

# Backend API
BACKEND_API_URL=http://localhost:5000/api

# WhatsApp client configuration
# Set true to launch the linked WhatsApp client automatically at startup.
AUTO_START_CLIENT=false
# Set true to run Chrome without a visible window.
CHROME_HEADLESS=false
# Optional: set CHROME_BIN only when Chrome is not installed in its default location.
